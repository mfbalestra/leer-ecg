{
  "name": "leer-ecg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --check .",
    "lint": "eslint src e2e kit vite.config.ts vitest.config.mts playwright.config.ts",
    "typecheck": "tsc -b",
    "types": "node kit/verificar-types.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "mapa": "node kit/verificar-mapa.mjs --mapa .agents/skills/verificar-leer-ecg/SKILL.md --rutas src/rutas.ts",
    "check": "node kit/registrar-verificacion.mjs --inicio \"npm run check\" && npm run format && npm run lint && npm run typecheck && npm run types && node kit/verificar-tiempos.mjs && npm run mapa && npm run consola:verificar && node kit/registrar-verificacion.mjs \"npm run check\"",
    "check:entrega": "npm run check && npm run e2e",
    "operar": "node consola/operar.mjs",
    "consola:verificar": "node consola/operar.mjs --listar-json > .consola.json && node kit/check-consola.mjs --manifiesto package.json --registro .consola.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.103.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.7",
    "shadcn": "4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "prettier": "./kit/prettier.config.json",
  "description": "Entrenador interactivo para aprender a leer un electrocardiograma"
}
